# Copy this file to .env and fill in the values.
# Firebase
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# EmailJS — https://www.emailjs.com/
# 1. Create a free account at emailjs.com, connect an email service (Gmail, etc.)
# 2. Create two email templates (see template variable reference below)
# 3. Copy your Public Key from EmailJS Account → API Keys
#
# Admin template variables (notifies admin on new guest request):
#   {{guest_name}}, {{guest_email}}, {{guest_phone}}, {{start_date}}, {{end_date}}, {{notes}}
#
# Guest template variables (notifies guest on confirm/reject):
#   {{to_email}}, {{guest_name}}, {{status}}, {{start_date}}, {{end_date}}, {{rejection_note}}
#   (Set the "To Email" field in the template to: {{to_email}})
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_GUEST_TEMPLATE_ID=
